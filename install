#!/bin/sh
# The network bootstrap deliberately does only platform selection and
# verification. The downloaded Rust CLI owns the complete installation.
#
# The whole script is one brace group: sh parses it completely before running
# anything, so a download cut short anywhere is a syntax error, never a partial
# installation that reports success.
{
set -eu

repository=gakonst/nanocodex

say() { printf 'nanocodex: %s\n' "$*" >&2; }
die() { say "$@"; exit 1; }

# request CURL_ARGS...
# Runs curl, whose --write-out must start with %{http_code}, and leaves that
# output in request_result. Interrupted or stalled transfers (below 1 KiB/s for
# 60s), resolver and connection failures, 408, 429 and 5xx are retried with
# backoff; other HTTP and local errors fail at once.
request() {
  request_attempt=1
  request_delay=1
  while :; do
    request_status=0
    request_result="$(
      curl --fail --show-error --proto '=https' --proto-redir '=https' \
        --connect-timeout 20 --speed-limit 1024 --speed-time 60 "$@"
    )" || request_status=$?
    request_code=${request_result%% *}
    if [ "$request_status" -eq 0 ]; then
      return 0
    fi
    # A body that drops mid-transfer still reports HTTP 200, so classify by
    # curl's exit status first and consult the HTTP code only for exit 22.
    case "$request_status" in
      22)
        case "$request_code" in
          408|429|5??) ;;
          403)
            say "GitHub refused the request (HTTP 403), possibly its rate limit for this network or a proxy; retry later or pin NANOCODEX_RELEASE_TAG"
            return 1
            ;;
          *)
            say "request failed with HTTP $request_code"
            return 1
            ;;
        esac
        ;;
      5|6|7|16|18|28|35|52|55|56|92) ;;
      *)
        say "request failed (curl exit $request_status)"
        return 1
        ;;
    esac
    if [ "$request_attempt" -ge "$request_attempts" ]; then
      say "request failed after $request_attempt attempts (curl exit $request_status, HTTP ${request_code:-none})"
      if [ "$request_code" = 429 ]; then
        say "GitHub is rate limiting this network; retry later or pin NANOCODEX_RELEASE_TAG"
      else
        say "check the network or proxy, then rerun the same command"
      fi
      return 1
    fi
    say "request interrupted (curl exit $request_status, HTTP ${request_code:-none}); retry $((request_attempt + 1))/$request_attempts in ${request_delay}s"
    sleep "$request_delay"
    request_attempt=$((request_attempt + 1))
    request_delay=$((request_delay * 2))
  done
}

# fetch URL OUTPUT [bootstrap]
# The body lands in OUTPUT.part and moves into place only after a complete
# transfer, so an interrupted download is never verified or executed. Small
# metadata files are capped at 60s per attempt; the bootstrap is bounded by
# the stall detector instead, so slow links can still finish.
fetch() {
  rm -f -- "$2.part"
  fetch_status=0
  if [ "${3:-}" = bootstrap ]; then
    fetch_meter=--silent
    if [ -t 2 ]; then fetch_meter=--progress-bar; fi
    request "$fetch_meter" --location --write-out '%{http_code}' \
      --output "$2.part" "$1" || fetch_status=$?
  else
    request --silent --max-time 60 --location --write-out '%{http_code}' \
      --output "$2.part" "$1" || fetch_status=$?
  fi
  if [ "$fetch_status" -eq 0 ] && mv -f -- "$2.part" "$2"; then
    return 0
  fi
  rm -f -- "$2.part"
  say "could not download $1"
  return 1
}

# run_tagged_installer ARGS...
# Serialize bootstraps for one installation directory so running the command
# twice waits instead of failing on the native update lock, and wait for a
# background automatic update that holds that lock. flock(1) locks belong to
# the kernel and vanish when their holder exits, so no stale lock can remain;
# --close keeps services started by setup from inheriting it. Without a
# util-linux flock(1), as on stock macOS or BusyBox, the native installer's own
# lock still reports a concurrent run.
run_tagged_installer() {
  lock_root=${NANOCODEX_DIR:-${HOME:+$HOME/.nanocodex}}
  lock_file=$lock_root/bootstrap.lock
  tagged_status=0
  lock_state=unavailable
  if [ -n "$lock_root" ] && command -v flock >/dev/null 2>&1 \
    && mkdir -p -- "$lock_root" 2>/dev/null; then
    # Probe the exact options used below: 0 is free, 211 is held, and anything
    # else (a usage error) means this flock cannot be used.
    lock_probe=0
    flock --close -E 211 -n "$lock_file" true 2>/dev/null || lock_probe=$?
    case "$lock_probe" in
      0) lock_state=free ;;
      211) lock_state=held ;;
    esac
  fi
  if [ "$lock_state" = unavailable ]; then
    NANOCODEX_RELEASE_BOOTSTRAP=1 NANOCODEX_RELEASE_TAG="$release_tag" \
      "$tagged_installer" "$@" || tagged_status=$?
    return "$tagged_status"
  fi
  if [ -f "$lock_root/update.lock" ] \
    && ! flock -n "$lock_root/update.lock" true 2>/dev/null; then
    say "a background Nanocodex update is running; waiting up to ${lock_timeout}s for it to finish"
    flock -w "$lock_timeout" "$lock_root/update.lock" true 2>/dev/null || :
  fi
  if [ "$lock_state" = held ]; then
    say "another Nanocodex installation is running for $lock_root; waiting up to ${lock_timeout}s for it to finish"
  fi
  # 211 marks a lock timeout. A tagged installer that itself exited 211 would
  # be reported as one; no installer uses that status.
  flock --close -E 211 -w "$lock_timeout" "$lock_file" \
    env NANOCODEX_RELEASE_BOOTSTRAP=1 NANOCODEX_RELEASE_TAG="$release_tag" \
    "$tagged_installer" "$@" || tagged_status=$?
  if [ "$tagged_status" -eq 211 ]; then
    die "another installation still holds $lock_file after ${lock_timeout}s; rerun once it finishes"
  fi
  return "$tagged_status"
}

cleanup() {
  if [ -n "${temporary_dir:-}" ]; then
    rm -rf -- "$temporary_dir" 2>/dev/null || say "could not remove $temporary_dir"
  fi
}

# Use a temporary directory that permits execution: /tmp is noexec on many
# hardened hosts, which would otherwise fail with "Permission denied".
make_temporary_dir() {
  requested_root=${TMPDIR:-/tmp}
  for temporary_root in "$requested_root" "${HOME:+$HOME/.cache/nanocodex}"; do
    [ -n "$temporary_root" ] || continue
    mkdir -p -- "$temporary_root" 2>/dev/null || continue
    candidate="$(mktemp -d "$temporary_root/nanocodex-bootstrap.XXXXXX" 2>/dev/null)" || continue
    if printf '#!/bin/sh\nexit 0\n' > "$candidate/probe" 2>/dev/null \
      && chmod 755 "$candidate/probe" && "$candidate/probe" 2>/dev/null; then
      rm -f -- "$candidate/probe"
      temporary_dir=$candidate
      if [ "$temporary_root" != "$requested_root" ]; then
        say "$requested_root does not allow execution; using $temporary_root"
        # Tagged installers that predate this probe create their own directory.
        TMPDIR=$temporary_root
        export TMPDIR
      fi
      return 0
    fi
    rm -rf -- "$candidate"
  done
  die "could not create an executable temporary directory; set TMPDIR to a writable directory that allows execution"
}

usage() {
  cat <<'USAGE'
Install Nanocodex:  curl -fsSL https://nanocodex.paradigm.xyz | bash
Pass options after "bash -s --", for example:  ... | bash -s -- --nightly

  --nightly         install the newest nightly build and follow nightly updates
                    (the default is the latest stable release)
  --no-setup        install the binaries without guided login and Hand setup
  --no-modify-path  do not add the Nanocodex bin directory to the shell profile
  -h, --help        show this help without downloading anything

Environment:
  NANOCODEX_RELEASE_TAG=vMAJOR.MINOR.PATCH or nightly-<40-hex commit>
                    install that exact release
  NANOCODEX_DIR     installation directory (default ~/.nanocodex)
USAGE
}

main() {
  # Validate options before any download: a typo or --help costs nothing.
  # Options reach every tagged installer, so a new native install option must
  # be accepted here first.
  install_nightly=
  passthrough=
  for argument do
    case "$argument" in
      --nightly) install_nightly=1 ;;
      --no-setup|--no-modify-path) passthrough="$passthrough $argument" ;;
      -h|--help) usage; exit 0 ;;
      *)
        say "unknown option '$argument'"
        usage >&2
        exit 2
        ;;
    esac
  done
  # Only the fixed option words above are kept, so word splitting is safe.
  # shellcheck disable=SC2086
  set -- $passthrough
  command -v curl >/dev/null 2>&1 || die "curl is required; install it, then rerun this command"
  request_attempts=${NANOCODEX_INSTALL_ATTEMPTS:-4}
  case "$request_attempts" in ''|*[!0-9]*|0) request_attempts=4 ;; esac
  lock_timeout=${NANOCODEX_INSTALL_LOCK_TIMEOUT:-900}
  case "$lock_timeout" in ''|*[!0-9]*) lock_timeout=900 ;; esac

  # A headless process can see /dev/tty without owning a controlling terminal.
  # Probe opening it, and pass the fallback through to older tagged installers.
  setup_tty=${NANOCODEX_INSTALL_TTY:-/dev/tty}
  if ! ( : < "$setup_tty" ) 2>/dev/null; then
    setup_tty=/dev/null
  fi
  NANOCODEX_INSTALL_TTY=$setup_tty
  export NANOCODEX_INSTALL_TTY

  temporary_dir=
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' HUP TERM
  make_temporary_dir

  release_tag=${NANOCODEX_RELEASE_TAG:-}
  if [ -n "$install_nightly" ] && [ "${NANOCODEX_RELEASE_BOOTSTRAP:-0}" != 1 ]; then
    if [ -n "$release_tag" ]; then
      die "--nightly conflicts with NANOCODEX_RELEASE_TAG=$release_tag; use only one"
    fi
    # The moving nightly release names its immutable nightly-<commit> tag,
    # exactly as nanocodex update --nightly resolves it.
    fetch "https://api.github.com/repos/$repository/releases/tags/nightly" \
      "$temporary_dir/nightly.json" \
      || die "could not look up the nightly release; rerun, or pin one with NANOCODEX_RELEASE_TAG=nightly-<commit>"
    tr ',{}' '\n\n\n' < "$temporary_dir/nightly.json" > "$temporary_dir/nightly.fields"
    grep -q '^[[:space:]]*"tag_name"[[:space:]]*:[[:space:]]*"nightly"[[:space:]]*$' \
      "$temporary_dir/nightly.fields" \
      || die "GitHub returned unexpected nightly release metadata; rerun, or pin NANOCODEX_RELEASE_TAG=nightly-<commit>"
    nightly_commit="$(
      sed -n 's/^[[:space:]]*"target_commitish"[[:space:]]*:[[:space:]]*"\([0-9a-fA-F]*\)"[[:space:]]*$/\1/p' \
        "$temporary_dir/nightly.fields" | head -n 1 | tr 'A-F' 'a-f'
    )"
    if [ "${#nightly_commit}" -ne 40 ]; then
      die "GitHub's nightly release does not name a 40-hex commit (got '$nightly_commit'); rerun later, or pin NANOCODEX_RELEASE_TAG=nightly-<commit>"
    fi
    release_tag=nightly-$nightly_commit
  fi
  if [ -z "$release_tag" ]; then
    request --silent --max-time 60 --head --output /dev/null --write-out '%{http_code} %{redirect_url}' \
      "https://github.com/$repository/releases/latest" \
      || die "could not look up the latest release; rerun, or pin one with NANOCODEX_RELEASE_TAG=vMAJOR.MINOR.PATCH"
    release_redirect=${request_result#* }
    release_tag=${release_redirect##*/}
    case "$release_redirect" in
      "https://github.com/$repository/releases/tag/"*) ;;
      *) die "GitHub did not report the latest release (HTTP $request_code, redirect '$release_redirect'); rerun, or pin one with NANOCODEX_RELEASE_TAG=vMAJOR.MINOR.PATCH" ;;
    esac
  fi
  case "$release_tag" in
    nightly-*)
      commit=${release_tag#nightly-}
      case "$commit" in ''|*[!0-9a-fA-F]*) release_tag= ;; esac
      if [ "${#commit}" -ne 40 ]; then release_tag=; fi
      ;;
    v*)
      version=${release_tag#v}
      major=${version%%.*}
      remainder=${version#*.}
      minor=${remainder%%.*}
      patch=${remainder#*.}
      if [ "$remainder" = "$version" ] || [ "$patch" = "$remainder" ]; then release_tag=; fi
      case "$major" in ''|*[!0-9]*) release_tag= ;; esac
      case "$minor" in ''|*[!0-9]*) release_tag= ;; esac
      case "$patch" in ''|*[!0-9]*) release_tag= ;; esac
      ;;
    *) release_tag= ;;
  esac
  if [ -z "$release_tag" ]; then
    die "expected a stable vMAJOR.MINOR.PATCH or nightly-<full 40-hex commit> release tag"
  fi
  # Preserve the selected release through the native installation stage too.
  NANOCODEX_RELEASE_TAG=$release_tag
  export NANOCODEX_RELEASE_TAG

  # The public URL follows master, while native artifacts are published from a
  # release tag. Load the install contract from that tag first so a merge can
  # never pair a newer script with an older binary. Tagged installers set the
  # stage marker for their second pass and download from the exact same tag.
  # This first stage retries only its own lookups and the tagged installer
  # download; a tagged installer that predates these retries still makes one
  # attempt for its manifest and bootstrap. The installation lock below covers
  # every tagged installer.
  if [ "${NANOCODEX_RELEASE_BOOTSTRAP:-0}" != 1 ]; then
    tagged_installer="$temporary_dir/install"
    fetch "https://raw.githubusercontent.com/$repository/refs/tags/$release_tag/install" \
      "$tagged_installer" || die "could not download the $release_tag installer"
    # Each tagged installer runs under its own shebang; check POSIX ones fully.
    case "$(head -n 1 "$tagged_installer")" in
      '#!/bin/sh'*) sh -n "$tagged_installer" 2>/dev/null ;;
      '#!'*) true ;;
      *) false ;;
    esac || die "the downloaded $release_tag installer is incomplete; rerun the same command"
    chmod 755 "$tagged_installer"
    run_tagged_installer "$@" || exit
    exit 0
  fi

  case "$(uname -s)" in
    Linux) platform=unknown-linux-gnu ;;
    Darwin) platform=apple-darwin ;;
    *)
      say "unsupported operating system $(uname -s)"
      die "Download a native installer from https://github.com/$repository/releases/latest"
      ;;
  esac

  case "$(uname -m)" in
    x86_64|amd64) architecture=x86_64 ;;
    arm64|aarch64) architecture=aarch64 ;;
    *) die "unsupported architecture $(uname -m)" ;;
  esac
  # A shell translated by Rosetta reports x86_64 on Apple Silicon.
  if [ "$platform-$architecture" = apple-darwin-x86_64 ] \
    && [ "$(sysctl -n hw.optional.arm64 2>/dev/null || :)" = 1 ]; then
    architecture=aarch64
  fi
  if [ "$platform" = unknown-linux-gnu ] && ! ldd --version 2>&1 | grep -qi -e glibc -e 'gnu libc'; then
    if ldd --version 2>&1 | grep -qi musl || [ -e /lib/ld-musl-x86_64.so.1 ]; then
      die "this Linux uses musl libc; Nanocodex publishes glibc binaries only (use a glibc distribution or container)"
    fi
  fi

  case "$architecture-$platform" in
    x86_64-unknown-linux-gnu|aarch64-apple-darwin) ;;
    *) die "no release binary is published for $architecture-$platform" ;;
  esac

  if command -v sha256sum >/dev/null 2>&1; then
    sha256_file() { sha256sum "$1" | awk '{ print $1 }'; }
  elif command -v shasum >/dev/null 2>&1; then
    sha256_file() { shasum -a 256 "$1" | awk '{ print $1 }'; }
  else
    die "sha256sum or shasum is required to verify the bootstrap"
  fi

  release_url="https://github.com/$repository/releases/download/$release_tag"
  fetch "$release_url/SHA256SUMS" "$temporary_dir/SHA256SUMS" \
    || die "could not download the $release_tag checksum manifest"

  binary="nanocodex-$architecture-$platform"
  compressed="$binary.gz"
  if awk -v asset="$compressed" '$2 == asset || $2 == "*" asset { found = 1 } END { exit !found }' \
    "$temporary_dir/SHA256SUMS"; then
    asset=$compressed
    packed=1
  elif awk -v asset="$binary" '$2 == asset || $2 == "*" asset { found = 1 } END { exit !found }' \
    "$temporary_dir/SHA256SUMS"; then
    asset=$binary
    packed=0
  else
    die "SHA256SUMS contains no $binary bootstrap"
  fi

  echo "Downloading the verified Nanocodex bootstrap..."
  fetch "$release_url/$asset" "$temporary_dir/$asset" bootstrap \
    || die "could not download the $asset bootstrap"
  expected="$(awk -v asset="$asset" '$2 == asset || $2 == "*" asset { print $1; exit }' \
    "$temporary_dir/SHA256SUMS")"
  actual="$(sha256_file "$temporary_dir/$asset")"
  if [ -z "$expected" ] || [ "$actual" != "$expected" ]; then
    die "checksum mismatch for $asset"
  fi

  bootstrap="$temporary_dir/nanocodex"
  if [ "$packed" -eq 1 ]; then
    command -v gzip >/dev/null 2>&1 || die "gzip is required to unpack the bootstrap"
    gzip -dc "$temporary_dir/$asset" > "$bootstrap" || die "could not unpack $asset"
  else
    cp "$temporary_dir/$asset" "$bootstrap"
  fi
  chmod 755 "$bootstrap"
  # Report an unsupported C library plainly instead of a raw loader error.
  if ! "$bootstrap" --version > "$temporary_dir/version" 2> "$temporary_dir/loader"; then
    if grep -q 'GLIBC_[0-9]' "$temporary_dir/loader"; then
      required="$(grep -o 'GLIBC_[0-9][0-9.]*' "$temporary_dir/loader" | sed 's/GLIBC_//' | sort -t. -k1,1n -k2,2n | tail -n 1)"
      present="$(getconf GNU_LIBC_VERSION 2>/dev/null | awk '{ print $2 }')"
      die "this $release_tag build needs glibc $required or newer, but this system has glibc ${present:-unknown}; use a newer distribution or container"
    fi
    sed 's/^/  /' "$temporary_dir/loader" >&2
    die "the verified $asset bootstrap cannot run on this system"
  fi

  # A piped script has no interactive stdin. Lend the Rust setup the controlling
  # terminal when one exists; unattended installs remain resumable.
  setup_tty=${NANOCODEX_INSTALL_TTY:-/dev/tty}
  install_status=0
  if [ "${NANOCODEX_INSTALL_NO_SETUP:-0}" != 1 ] \
    && [ -r "$setup_tty" ] && [ -w "$setup_tty" ]; then
    "$bootstrap" install "$@" < "$setup_tty" || install_status=$?
  else
    "$bootstrap" install "$@" || install_status=$?
  fi
  if [ "$install_status" -ne 0 ]; then
    say "installation did not finish (exit $install_status); rerun the same command to resume"
  fi
  return "$install_status"
}

main "$@"
}
