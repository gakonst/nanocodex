{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanocodex-better-auth-example",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "nanocodex-better-auth-example",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "NANOCODEX_HOST_APP_ID": "replace-with-your-nanocodex-app-id",
    "NANOCODEX_HOST_APP_ORIGIN": "http://localhost:5173"
  },
  "observability": {
    "enabled": true
  }
}
