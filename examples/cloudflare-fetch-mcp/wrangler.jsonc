{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanocodex-fetch-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["src/**/*.wasm"],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HOSTED_AGENT",
        "class_name": "HostedNanocodex"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HostedNanocodex"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
