{
  "name": "nanocodex-react-vite-example",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc --noEmit && vite build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test worker/*.test.mjs && node --experimental-strip-types --test test/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:mpp": "LIVE_MPP_E2E=1 playwright test --headed --grep 'live browser MPP'"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "accounts": "^0.14.12",
    "mppx": "0.8.17",
    "nanocodex": "workspace:*",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "viem": "^2.55.8",
    "wagmi": "^3.7.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "nanocodex-vite": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "wrangler": "^4.112.0"
  }
}
