{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanocodex-privy-example",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "PRIVY_APP_ID": "replace-with-your-development-privy-app-id",
    "NANOCODEX_HOST_APP_ID": "privy-example",
    "NANOCODEX_HOST_APP_ORIGIN": "http://localhost:5173",
    "NANOCODEX_API_URL": "https://api.nanocodex.xyz",
    "NANOCODEX_CONNECT_DIALOG_URL": "https://nanocodex.gakonst.workers.dev/connect-dialog/"
  }
}
