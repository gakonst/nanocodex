    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "nanocodex": "file:../../js/nanocodex",
    "nanocodex-react": "file:../../js/nanocodex-react",
    "nanocodex-terminal": "file:../../js/nanocodex-terminal",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "nanocodex-vite": "file:../../js/nanocodex-vite",
    "@types/chrome": "0.2.7",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "5.9.3",
    "wxt": "0.21.4"
  }
}
