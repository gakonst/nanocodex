{
  "name": "nanocodex-chrome-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "tsc --noEmit && wxt build",
