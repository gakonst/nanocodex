    "requiredFor": [
      "tab_cdp_call",
      "tab_cdp_events"
    ]
  },
  {
    "mode": "model",
    "name": "capabilities/tab/botDetection"
  },
  {
    "mode": "model",
    "name": "capabilities/tab/browserAuth",
    "requiredFor": [
      "tab_browser_auth_handoff"
