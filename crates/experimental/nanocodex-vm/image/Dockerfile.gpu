# Apple Silicon Venus driver. Build context is this image directory.
# Keep the hardware driver separate from the portable software desktop image.
FROM rust:1.97-alpine3.24 AS rust-toolchain
RUN rustup component add clippy rustfmt && rustup target add wasm32-unknown-unknown
FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS build
RUN apk add --no-cache build-base meson samurai python3 py3-mako py3-yaml \
    py3-packaging py3-setuptools bison flex libdrm-dev vulkan-headers zlib-dev \
    expat-dev libx11-dev libxrandr-dev libxshmfence-dev libxcb-dev \
    wayland-dev wayland-protocols linux-headers pkgconf curl xz
WORKDIR /build
FROM build AS venus
RUN curl --fail --location --output mesa.tar.xz https://archive.mesa3d.org/mesa-26.1.6.tar.xz \
    && echo '6746b73f5b87e8ff3723eee586b4b5f033dbe6d13cd0309d743b7fa484c350268859ec8ff21aadcbca7a04070cdaa7828146dd28dde4b1935bb879891d687f0b  mesa.tar.xz' | sha512sum -c - \
    && tar -xf mesa.tar.xz
COPY gpu/venus-16k.patch /build/venus-16k.patch
WORKDIR /build/mesa-26.1.6
# libkrunfw 6.12 uses 4K guest pages; Apple Hypervisor requires 16K mappings.
# Downstream maintainer patch, with a local copy instead of casting away const.
RUN patch -p1 -F0 < /build/venus-16k.patch \
    && meson setup build --prefix=/usr -Dbuildtype=release \
       -Dgallium-drivers= -Dvulkan-drivers=virtio -Dplatforms=x11 \
       -Dglx=disabled -Degl=disabled -Dgbm=disabled \
       -Dgles1=disabled -Dgles2=disabled -Dopengl=false \
       -Dllvm=disabled -Dbuild-tests=false \
    && meson compile -C build -j2 \
    && DESTDIR=/driver meson install -C build
RUN apk add --no-cache vulkan-loader-dev glslang
COPY gpu/check.c gpu/check.comp /build/
RUN glslangValidator -V /build/check.comp -o /build/check.spv \
    && python3 -c 'import struct; b=open("/build/check.spv","rb").read(); open("/build/check_spv.h","w").write("#include <stdint.h>\nstatic const uint32_t check_spv[]={"+",".join(hex(n) for n in struct.unpack("<%dI"%(len(b)//4),b))+"};\n")' \
    && mkdir -p /driver/usr/local/bin && cc -O2 -Wall -Wextra -Werror /build/check.c -lvulkan -o /driver/usr/local/bin/nanocodex-gpu-check
RUN mkdir -p /driver/usr/share/licenses/nanocodex-venus \
    && cp docs/license.rst /driver/usr/share/licenses/nanocodex-venus/
FROM build AS zink
# Later Zink releases require nullDescriptor, absent from MoltenVK. Do not
# pretend the feature exists. This isolated GL driver leaves system GL intact.
RUN curl --fail --location --output mesa.tar.xz https://archive.mesa3d.org/mesa-25.1.9.tar.xz \
    && echo '412df33a1bb3c785ed698555a3972118a37c458e7accf6ae53f4bb87b3db454a  mesa.tar.xz' | sha256sum -c - \
    && tar -xf mesa.tar.xz
COPY gpu/zink-xvfb.patch /build/zink-xvfb.patch
WORKDIR /build/mesa-25.1.9
RUN apk add --no-cache libxxf86vm-dev libxfixes-dev xorgproto \
    && patch -p1 -F0 < /build/zink-xvfb.patch \
    && meson setup build --prefix=/opt/nanocodex-gpu-gl --libdir=lib -Dbuildtype=release \
       -Dgallium-drivers=zink -Dvulkan-drivers= -Dplatforms=x11 \
       -Dglx=dri -Dglvnd=disabled -Degl=disabled -Dgbm=disabled \
       -Dgles1=disabled -Dgles2=disabled \
       -Dllvm=disabled -Dbuild-tests=false \
    && meson compile -C build -j2 \
    && DESTDIR=/driver meson install -C build
COPY gpu/gl-check.c /build/gl-check.c
RUN mkdir -p /driver/usr/local/bin \
    && cc -O2 -Wall -Wextra -Werror /build/gl-check.c \
       -I/driver/opt/nanocodex-gpu-gl/include -L/driver/opt/nanocodex-gpu-gl/lib \
       -Wl,-rpath-link,/driver/opt/nanocodex-gpu-gl/lib -lGL -lX11 \
       -o /driver/usr/local/bin/nanocodex-gpu-gl-check
RUN mkdir -p /driver/usr/share/licenses/nanocodex-gpu-gl \
    && cp docs/license.rst /driver/usr/share/licenses/nanocodex-gpu-gl/
FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
COPY --from=rust-toolchain /usr/local/rustup /opt/rustup
COPY --from=rust-toolchain /usr/local/cargo /opt/cargo
COPY toolkit/install-alpine.sh toolkit/python.txt /opt/hand-toolkit/
RUN sh /opt/hand-toolkit/install-alpine.sh
COPY toolkit/check.py toolkit/install-paths.sh /opt/hand-toolkit/
RUN sh /opt/hand-toolkit/install-paths.sh \
    && ln -s /opt/hand-toolkit/check.py /usr/local/bin/nanocodex-check-hand-toolkit \
    && chmod 0755 /opt/hand-toolkit/check.py
ENV RUSTUP_HOME=/opt/rustup \
    PATH=/opt/hand-python/bin:/opt/cargo/bin:$PATH \
    DISPLAY=:0
RUN apk add --no-cache mesa-vulkan-virtio vulkan-tools vulkan-loader libxxf86vm
COPY --from=venus /driver/usr/ /usr/
COPY --from=zink /driver/ /
COPY --chmod=755 gpu/gl /usr/local/bin/nanocodex-gpu-gl
ENV DISPLAY=:0
WORKDIR /app
CMD ["/bin/sh"]
