{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "nanocodex#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/.cargo/**",
        "$TURBO_ROOT$/js/nanocodex-vite/scripts/**",
        "$TURBO_ROOT$/crates/nanocodex/**",
        "$TURBO_ROOT$/crates/nanocodex-agent/**",
        "$TURBO_ROOT$/crates/nanocodex-muse/**",
        "$TURBO_ROOT$/crates/nanocodex-claude/**",
        "$TURBO_ROOT$/crates/nanocodex-claude-tools/**",
        "$TURBO_ROOT$/crates/nanocodex-durability/**",
        "$TURBO_ROOT$/crates/nanocodex-home/**",
        "$TURBO_ROOT$/crates/nanocodex-oai-api/**",
        "$TURBO_ROOT$/crates/nanocodex-subagents/**",
        "$TURBO_ROOT$/crates/nanocodex-oai-tools/**",
        "$TURBO_ROOT$/crates/nanocodex-voice-protocol/**"
      ],
      "env": [
        "RUSTFLAGS",
        "CARGO_ENCODED_RUSTFLAGS",
        "RUSTC",
        "RUSTC_WRAPPER",
        "RUSTC_WORKSPACE_WRAPPER",
        "CARGO_INCREMENTAL",
        "CARGO_PROFILE_*",
        "CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_*"
      ],
      "passThroughEnv": [
        "CARGO_HOME",
        "CARGO_TERM_COLOR",
        "NANOCODEX_WASM_OPT",
        "NANOCODEX_BINARYEN_CACHE",
        "BINARYEN_CORES",
        "CARGO_BUILD_JOBS",
        "CARGO_TARGET_DIR",
        "SCCACHE_*",
        "ACTIONS_CACHE_URL",
        "ACTIONS_RESULTS_URL",
        "ACTIONS_RUNTIME_TOKEN",
        "ACTIONS_CACHE_SERVICE_V2"
      ],
      "outputs": []
    },
    "@nanocodex/connect-api#build": {
      "dependsOn": ["nanocodex-connect-protocol#build"],
      "outputs": []
    },
    "nanocodex-tools#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "nanocodex-computer#test": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["NANOCODEX_TEST_NATIVE_APP", "NANOCODEX_TEST_BROWSER"],
      "outputs": []
    },
    "nanocodex-web#build": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
