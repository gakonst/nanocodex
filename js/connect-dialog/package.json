  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "react-test-renderer": "19.2.6",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "^4.0.18",
    "wrangler": "4.127.1"
  }
}
