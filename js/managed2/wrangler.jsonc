{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanocodex-managed2",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": { "required": ["AUTH_API_KEY_HASHES"] },
  "workers_dev": true,
  "alias": { "node-rsa": "../nanocodex/tools/browser/unsupportedNodeRsa.mjs" },
  "find_additional_modules": true,
  "base_dir": "src",
  "rules": [{ "type": "ESModule", "globs": ["**/just-bash-lazy.mjs"] }],
  "vars": { "RESPONSES_TRANSPORT": "websocket" },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "Session"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Session"
      ]
    }
  ],
  "services": [
    {
      "binding": "EGRESS",
      "service": "nanocodex-egress2"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "preview_urls": false
}
