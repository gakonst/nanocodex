{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanocodex-durable-agent-test",
  "main": "test/memory-scope-worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat", "durable_object_io_tasks_prevent_eviction", "global_fetch_strictly_public", "enable_request_signal"],
  "alias": {
    "node-rsa": "../nanocodex/tools/browser/unsupportedNodeRsa.mjs"
  },
  "d1_databases": [
    { "binding": "NANOCODEX_CRM", "database_name": "nanocodex-crm-test", "database_id": "nanocodex-crm-test", "migrations_dir": "migrations", "remote": false }
  ],
  "r2_buckets": [
    {
      "binding": "NANOCODEX_HISTORY",
      "bucket_name": "nanocodex-managed-history-test"
    },
    {
      "binding": "NANOCODEX_USER_DATA_OBJECTS",
      "bucket_name": "nanocodex-user-data-test"
    },
    {
      "binding": "NANOCODEX_WORKSPACES",
      "bucket_name": "nanocodex-sandbox-workspaces-test"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NANOCODEX_CALENDAR_PUSH", "class_name": "CalendarPushDelivery" },
      { "name": "NANOCODEX_INFERENCE_KEYS", "class_name": "InferenceKey" },
      { "name": "NANOCODEX_INFERENCE_ACCOUNTS", "class_name": "InferenceAccount" },
      { "name": "NANOCODEX_INFERENCE_SESSIONS", "class_name": "InferenceSession" },
      { "name": "NANOCODEX_MEETING_PREVIEWS", "class_name": "MeetingPreview" },
      { "name": "NANOCODEX_PROVIDER_PROBE_COORDINATOR", "class_name": "ProviderProbeCoordinator" },
      {
        "name": "NANOCODEX_MEMORY",
        "class_name": "MemoryScope"
      },
      {
        "name": "NANOCODEX_USER_DATA",
        "class_name": "UserDataScope"
      },
      {
        "name": "NANOCODEX_ACCOUNT_TOOLS",
        "class_name": "AccountHostedTools"
      },
      {
        "name": "NANOCODEX_VM_HOST_POOLS",
        "class_name": "VmHostPool"
      },
      {
        "name": "NANOCODEX_SESSIONS",
        "class_name": "DurableAgentSession"
      },
      {
        "name": "NANOCODEX_USERS",
        "class_name": "UserAccount"
      },
      {
        "name": "NANOCODEX_ORGANIZATIONS",
        "class_name": "Organization"
      },
      {
        "name": "NANOCODEX_API_KEYS",
        "class_name": "ApiKeyRecord"
      }
    ]
  },
  "migrations": [
    { "tag": "regional-hand-test-v1", "new_sqlite_classes": ["RegionalHandRelay"] },
    { "tag":"calendar-push-test-v1", "new_sqlite_classes":["CalendarPushDelivery"] },
    { "tag": "inference-v1", "new_sqlite_classes": ["InferenceKey", "InferenceAccount", "InferenceSession"] },
    { "tag": "meeting-preview-test-v1", "new_sqlite_classes": ["MeetingPreview"] },
    { "tag": "provider-probe-test-v1", "new_sqlite_classes": ["ProviderProbeCoordinator"] },
    {
      "tag": "memory-scope-v1",
      "new_sqlite_classes": ["MemoryScope"]
    },
    {
      "tag": "account-hosted-tools-v1",
      "new_sqlite_classes": ["AccountHostedTools"]
    },
    {
      "tag": "managed-session-v1",
      "new_sqlite_classes": ["DurableAgentSession"]
    },
    {
      "tag": "vm-host-pool-v1",
      "new_sqlite_classes": ["VmHostPool"]
    },
    {
      "tag": "user-account-test-v1",
      "new_sqlite_classes": ["UserAccount"]
    },
    {
      "tag": "organization-test-v1",
      "new_sqlite_classes": ["Organization"]
    },
    {
      "tag": "user-data-test-v1",
      "new_sqlite_classes": ["UserDataScope"]
    },
    {
      "tag": "api-key-record-test-v1",
      "new_sqlite_classes": ["ApiKeyRecord"]
    }
  ]
}
