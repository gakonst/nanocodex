{
  "name": "nanocodex-managed-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "rm -rf dist && wrangler deploy --dry-run --outdir dist --config wrangler.jsonc",
    "check": "npm run typecheck && npm test && npm run build",
    "predeploy": "npm run prepare:code-evaluator",
    "deploy": "node ../../scripts/cloudflare/managed-crm.mjs deploy",
    "prebuild": "npm run prepare:code-evaluator",
    "prepare:code-evaluator": "node scripts/prepare-code-evaluator.mjs && node scripts/prepare-hand-image.mjs && node scripts/prepare-just-bash-lazy.mjs",
    "test": "vitest run && npm run test:sms-otp && npm run test:connect-signin && npm run test:mcp-hosted-authorization && npm run test:native-input-discovery && npm run test:hosted-tools && npm run test:apps && npm run test:rpc-lifecycle && npm run test:discovery-cache && npm run test:routing && npm run test:todo-mail && npm run test:done && npm run test:meetings && npm run test:recovery && npm run test:startup && npm run test:model-pause && npm run test:tool-timing && npm run test:regional-hand-relay && npm run test:hand-reconnect && npm run test:hand-owner-restart && npm run test:hand-leased-recovery && npm run test:hand-communication && npm run test:hand-discovery && npm run test:cua-routing && npm run test:claude-managed && npm run test:hand-catalog-scaling && npm run test:hand-preparation && npm run test:code-mode-warm && npm run test:user-data && npm run test:whatsapp && npm run test:permissions && npm run test:crm-search && npm run test:vault-requests && npm run test:agent-runs && npm run test:code-mode-only",
    "test:sms-otp": "node --test test/sms-otp-journey.test.mjs",
    "test:connect-signin": "node ../egress/scripts/prepare-whatsapp.mjs && node --test test/connect-signin-broker-journey.test.mjs",
    "test:mcp-hosted-authorization": "node --test test/mcp-hosted-authorization-journey.test.mjs",
    "test:browser-login": "node --experimental-strip-types scripts/browser-login-chrome.mjs",
    "test:apps": "vitest run --config vitest.apps.config.ts",
    "test:agent-runs": "node --test test/agent-run-stream-journey.test.mjs",
    "test:apps:native": "node --test test/native-app-validation-journey.test.mjs",
    "test:discovery-cache": "node --test test/account-discovery-isolates.test.mjs",
    "test:native-input-discovery": "node --test test/native-input-discovery-journey.test.mjs",
    "test:preview-bridge": "node --test test/preview-bridge-journey.test.mjs",
    "test:pending-io:live": "node --test test/pending-io-live.mjs",
    "test:rpc-lifecycle": "node --test test/rpc-lifecycle.test.mjs",
    "typecheck": "tsc --noEmit",
    "phone:bridge": "node scripts/phone-bridge.mjs",
    "test:phone": "vitest run test/phone-tool.test.ts test/twilio-voice.test.ts test/phone-container.test.ts && node --test scripts/phone-bridge.test.mjs scripts/phone-delegation.test.mjs scripts/phone-media-diagnostics.test.mjs",
    "test:routing": "vitest run --config vitest.routing.config.ts && node --test test/provider-telemetry.test.mjs && npm run test:routing:wasm",
    "test:routing:wasm": "node --test test/thread-routing-wasm.test.mjs",
    "test:media": "node --test scripts/media/runtime.test.mjs",
    "test:user-data": "vitest run --config vitest.user-data.config.ts && node --test test/user-data-persistence-journey.test.mjs",
    "test:memory": "vitest run --config vitest.memory.config.ts",
    "preview": "node ../../scripts/cloudflare/managed-crm.mjs preview",
    "db:migrate:local": "wrangler d1 migrations apply NANOCODEX_CRM --local --env development --config wrangler.jsonc --persist-to ../account/.wrangler/state",
    "test:done": "node --test test/session-done-journey.test.mjs",
    "test:todo-mail": "node --test test/todo-mail-journey.test.mjs test/todo-snooze-journey.test.mjs",
    "test:meetings": "node --test test/meeting-library-journey.test.mjs",
    "fixture:meetings": "node scripts/meeting-library-fixture.mjs",
    "test:images:node": "node --experimental-transform-types --import ./test-fixtures/node-types-loader.mjs --test test/managed-images-node.test.mjs",
    "test:images": "npm run test:images:node && vitest run --config vitest.images.config.ts",
    "test:recovery": "node --test test/managed-crash-recovery-journey.test.mjs",
    "test:startup": "node --test test/startup-overlap-journey.test.mjs",
    "test:model-pause": "node --test test/model-pause-journey.test.mjs",
    "test:tool-timing": "node --test test/thread-tool-timing-journey.test.mjs test/just-bash-telemetry-journey.test.mjs",
    "test:hand-reconnect": "node --test test/hand-reconnect-journey.test.mjs",
    "test:hand-owner-restart": "node --test test/hand-owner-restart-journey.test.mjs",
    "test:hand-communication": "node --test test/hand-communication-journey.test.mjs",
    "test:hand-leased-recovery": "node --test test/hand-leased-recovery-journey.test.mjs",
    "test:hosted-tools": "vitest run --config vitest.hosted-tools.config.ts",
    "test:cua-routing": "node --test test/cua-routing-journey.test.mjs",
    "test:hand-discovery": "node --test test/hand-discovery-journey.test.mjs",
    "test:claude-managed": "node --test test/claude-managed-journey.test.mjs",
    "test:hand-catalog-scaling": "node --test test/hand-catalog-scaling-journey.test.mjs",
    "test:hand-preparation": "node --test test/hand-preparation-journey.test.mjs",
    "test:code-mode-warm": "node --test test/code-mode-warm-latency-journey.test.mjs",
    "test:whatsapp": "node --test test/whatsapp-public-journey.test.mjs",
    "test:permissions": "node --test test/permission-requests-journey.test.mjs test/permission-tool-journey.test.mjs",
    "test:crm-search": "node scripts/prepare-code-evaluator.mjs && node scripts/prepare-just-bash-lazy.mjs && node --test test/crm-greek-search-journey.test.mjs",
    "test:vault-requests": "node --test test/vault-request-journey.test.mjs",
    "test:regional-hand-relay": "node --test test/regional-hand-relay-journey.test.mjs",
    "test:code-mode-only": "node --test test/code-mode-only-journey.test.mjs"
  },
  "dependencies": {
    "nanocodex-computer": "workspace:*",
    "@cloudflare/codemode": "0.5.1",
    "@cloudflare/computer": "0.2.1",
    "@cloudflare/sandbox": "0.12.4",
    "@jitl/quickjs-wasmfile-release-asyncify": "0.32.0",
    "accounts": "https://pkg.pr.new/tempoxyz/accounts@56efdd1",
    "agents": "0.22.0",
    "ai": "7.0.90",
    "cron-parser": "5.6.0",
    "mppx": "0.9.1",
    "nanocodex": "workspace:*",
    "nanocodex-connect-protocol": "workspace:*",
    "nanocodex-tools": "workspace:*",
    "nanocodex-vite": "workspace:*",
    "quickjs-emscripten-core": "0.32.0",
    "ox": "0.14.36",
    "viem": "2.57.2",
    "zod": "4.5.4",
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/node": "^22.20.1",
    "@xterm/headless": "5.5.0",
    "esbuild": "0.28.1",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "4.127.1",
    "ws": "^8.18.3"
  }
}
