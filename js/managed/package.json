{
  "name": "nanocodex-managed-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.jsonc",
    "check": "npm run typecheck && npm test && npm run build",
    "predeploy": "npm run prepare:code-evaluator",
    "deploy": "wrangler deploy --env=\"\" --config wrangler.jsonc",
    "prebuild": "npm run prepare:code-evaluator",
    "prepare:code-evaluator": "node scripts/prepare-code-evaluator.mjs && node scripts/prepare-hand-image.mjs",
    "test": "vitest run && npm run test:routing",
    "typecheck": "tsc --noEmit",
    "phone:bridge": "node scripts/phone-bridge.mjs",
    "test:phone": "vitest run test/phone-tool.test.ts test/twilio-voice.test.ts test/phone-container.test.ts && node --test scripts/phone-bridge.test.mjs scripts/phone-delegation.test.mjs",
    "test:routing": "vitest run --config vitest.routing.config.ts && node --test test/provider-telemetry.test.mjs && npm run test:routing:wasm",
    "test:routing:wasm": "node --test test/thread-routing-wasm.test.mjs",
    "test:media": "node --test scripts/media/runtime.test.mjs"
  },
  "dependencies": {
    "nanocodex-computer": "workspace:*",
    "@cloudflare/codemode": "0.5.1",
    "@cloudflare/computer": "0.2.1",
    "@cloudflare/sandbox": "0.12.4",
    "@jitl/quickjs-wasmfile-release-asyncify": "0.32.0",
    "accounts": "0.16.2",
    "agents": "0.22.0",
    "ai": "7.0.90",
    "cron-parser": "5.6.0",
    "nanocodex": "workspace:*",
    "nanocodex-connect-protocol": "workspace:*",
    "nanocodex-tools": "workspace:*",
    "nanocodex-vite": "workspace:*",
    "quickjs-emscripten-core": "0.32.0",
    "ox": "0.14.36",
    "viem": "^2.54.0",
    "zod": "4.5.4",
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/node": "^22.20.1",
    "esbuild": "0.28.1",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "4.127.1",
    "ws": "^8.18.3"
  }
}
