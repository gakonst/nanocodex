{
  "name": "nanocodex-perf-egress-0911",
  "main": "../../egress/src/egress.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "alias": {
    "node-rsa": "../../nanocodex/tools/browser/unsupportedNodeRsa.mjs"
  },
  "workers_dev": false,
  "minify": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "services": [
    {
      "binding": "MANAGED_AGENT_OWNERSHIP",
      "service": "nanocodex-perf-managed-0911",
      "entrypoint": "ManagedAgentOwnership"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_CREDENTIALS",
        "class_name": "UserCredentialBroker"
      },
      {
        "name": "AGENT_SUBJECTS",
        "class_name": "AgentSubjectDirectory"
      },
      {
        "name": "USER_CONNECTORS",
        "class_name": "UserConnectorBroker"
      },
      {
        "name": "MCP_CONNECTIONS",
        "class_name": "McpConnectionDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "UserCredentialBroker",
        "AgentSubjectDirectory",
        "UserConnectorBroker",
        "McpConnectionDirectory"
      ]
    }
  ]
}
