{
  "name": "nanocodex-computer",
  "version": "0.1.0",
  "description": "MCP attachment for the official OpenAI CUA provider",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs"
    },
    "./contract": {
      "types": "./contract.d.mts",
      "import": "./contract.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "contract.mjs",
    "contract.d.mts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit --module nodenext --moduleResolution nodenext index.d.mts contract.d.mts"
  },
  "dependencies": {
    "nanocodex-tools": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT OR Apache-2.0"
}
