{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanocodex-chief-of-staff",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  },
  "services": [
    {
      "binding": "NANOCODEX_BACKEND",
      "service": "nanocodex-durable-agent",
      "entrypoint": "ChiefOfStaffBackend"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHIEF_OF_STAFF_STATE",
        "class_name": "ChiefOfStaffState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChiefOfStaffState"]
    }
  ],
  "vars": {
    "CHIEF_OF_STAFF_ACCOUNT_ORIGIN": "https://nanocodex.gakonst.workers.dev",
    "CHIEF_OF_STAFF_PUBLIC_ORIGIN": "https://nanocodex-chief-of-staff.gakonst.workers.dev"
  },
  "env": {
    "development": {
      "name": "nanocodex-chief-of-staff",
      "services": [
        {
          "binding": "NANOCODEX_BACKEND",
          "service": "nanocodex-durable-agent",
          "entrypoint": "ChiefOfStaffBackend",
          "remote": false
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CHIEF_OF_STAFF_STATE",
            "class_name": "ChiefOfStaffState"
          }
        ]
      },
      "vars": {
        "CHIEF_OF_STAFF_ACCOUNT_ORIGIN": "https://nanocodex.gakonst.workers.dev",
        "CHIEF_OF_STAFF_PUBLIC_ORIGIN": "https://nanocodex-chief-of-staff.gakonst.workers.dev"
      }
    }
  }
}
