{
  "name": "@nanocodex/chief-of-staff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\" --config wrangler.jsonc",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "deploy": "wrangler deploy --env=\"\" --config wrangler.jsonc",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chat-adapter/slack": "4.39.0",
    "@chat-adapter/whatsapp": "4.39.0",
    "chat": "4.39.0",
    "nanocodex": "workspace:*",
    "nanocodex-tools": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/node": "^22.20.1",
    "typescript": "5.9.3",
    "wrangler": "4.127.1"
  }
}
