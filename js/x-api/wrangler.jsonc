{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanocodex-x",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "env": {
    "development": {
      "name": "nanocodex-x"
    }
  }
}
