{
  "name": "nanocodex-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "portless",
    "predev:app": "CI=1 wrangler d1 migrations apply EVALS_DB --local --env development --config wrangler.jsonc && pnpm --filter nanocodex-managed-service run prepare:code-evaluator",
    "dev:app": "CLOUDFLARE_ENV=development vite",
    "sync": "node scripts/sync-nanocodex.mjs",
    "publish:repository": "node scripts/publish-repository.mjs",
    "test": "npm run test:web && npm run test:claude-connection && npm run test:permissions",
    "test:permissions": "node scripts/permission-request-journey.mjs",
    "test:wallet": "node scripts/wallet-smoke.mjs && node scripts/wallet-link-journey.mjs",
    "test:web": "node --experimental-strip-types --test src/*.test.ts worker/*.test.ts container/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "gen:types": "wrangler types",
    "build": "tsc --noEmit && vite build && npm run check:docs",
    "deploy": "wrangler deploy --env=\"\" --config dist/nanocodex/wrangler.json",
    "preview": "vite preview",
    "test:claude-connection": "node scripts/claude-connection-smoke.mjs",
    "test:whatsapp": "node scripts/whatsapp-ui-journey.mjs",
    "test:vault": "node scripts/vault-ui-journey.mjs"
  },
  "portless": {
    "name": "nanocodex",
    "script": "dev:app"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "nanocodex-vite": "workspace:*",
    "nanocodex-connect-protocol": "workspace:*",
    "nanocodex-connect-ui": "workspace:*",
    "@noble/hashes": "1.8.0",
    "@pierre/diffs": "1.2.12",
    "@pierre/theme": "^1.1.0",
    "@pierre/trees": "^1.0.0-beta.5",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-switch": "1.2.6",
    "@shikijs/langs": "^4.3.1",
    "@shikijs/types": "^4.3.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.6",
    "accounts": "https://pkg.pr.new/tempoxyz/accounts@232cc59cb4f8b4c8daf2113d0881b161e76a69d3",
    "diff": "^9.0.0",
    "htm": "3.1.1",
    "isomorphic-git": "^1.41.5",
    "lucide-react": "^1.24.0",
    "nanocodex": "workspace:*",
    "nanocodex-react": "workspace:*",
    "nanocodex-terminal": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^7.18.2",
    "recharts": "^3.10.1",
    "shiki": "^4.3.1",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "fake-indexeddb": "6.2.4",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "wrangler": "4.137.0",
    "ws": "^8.21.3",
    "esbuild": "0.28.1",
    "playwright-core": "1.62.1"
  },
  "overrides": {
    "ws": "^8.21.3"
  }
}
