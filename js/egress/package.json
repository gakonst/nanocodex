{
  "name": "nanocodex-egress-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run prepare:whatsapp && vitest run && node --experimental-strip-types --test test/wallet-link-journey.node.test.mjs test/mercator-payment.node.test.mjs test/chatgpt-failover-journey.test.mjs test/session-model-journey.test.mjs test/credential-snapshot-journey.test.mjs test/prepared-model-upgrade-journey.test.mjs && npm run test:whatsapp && npm run test:vault-requests && npm run test:phone-service",
    "dry-run:agent": "wrangler deploy --dry-run --config wrangler.agent.jsonc",
    "deploy:agent": "wrangler deploy --config wrangler.agent.jsonc",
    "dry-run:broker": "wrangler deploy --dry-run --config wrangler.broker.jsonc",
    "deploy:broker": "wrangler deploy --env=\"\" --config wrangler.broker.jsonc",
    "prepare:whatsapp": "node scripts/prepare-whatsapp.mjs",
    "test:whatsapp-runtime": "node test/whatsapp-runtime/run.mjs",
    "test:whatsapp": "node --test test/whatsapp-account.node.test.mjs test/whatsapp-broker.node.test.mjs && npm run test:whatsapp-runtime",
    "test:vault-browser": "node test/vault-browser-journey.mjs",
    "test:vault-requests": "node --test test/vault-signing-journey.node.test.mjs test/vault-totp-journey.node.test.mjs",
    "test:wallet-link": "npm run prepare:whatsapp && node --test test/wallet-link-journey.node.test.mjs",
    "test:phone-service": "node --test test/phone-service-journey.node.test.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "accounts": "https://pkg.pr.new/tempoxyz/accounts@232cc59cb4f8b4c8daf2113d0881b161e76a69d3",
    "mppx": "0.11.0",
    "nanocodex": "workspace:*",
    "ox": "0.14.45",
    "viem": "2.57.2",
    "whatsapp-rust-bridge": "0.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260730.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20260828.0-alpha",
    "typescript": "5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "4.127.1",
    "ws": "8.21.0"
  }
}
