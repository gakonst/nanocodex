{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nanocodex-egress",
  "main": "src/egress.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "build": { "command": "node scripts/prepare-whatsapp.mjs" },
  "alias": {
    "@whiskeysockets/baileys": "./src/whatsapp-generated/baileys.js",
    "node-rsa": "../nanocodex/tools/browser/unsupportedNodeRsa.mjs"
  },
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm", "nanocodex/wasm"], "fallthrough": true }],
  "workers_dev": false,
  "minify": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "services": [
    { "binding": "TWILIO_PHONE_PROVIDER", "service": "nanocodex-durable-agent", "entrypoint": "PhoneProvider" },
    {
      "binding": "MANAGED_AGENT_OWNERSHIP",
      "service": "nanocodex-durable-agent",
      "entrypoint": "ManagedAgentOwnership"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CHATGPT_VOICE_RELAY_RPC": "true",
    "PHONE_PROVISIONING_ENABLED": "false",
    "PHONE_MAX_NUMBERS_PER_OWNER": "3",
    "PHONE_MESSAGE_TTL_SECONDS": "86400",
    "PHONE_WEBHOOK_URL": "https://nanocodex.gakonst.workers.dev/v1/services/phone/webhook"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PHONE_SERVICE_ACCOUNTS", "class_name": "PhoneServiceAccount" },
      { "name": "GMAIL_PUSH_MAILBOXES", "class_name": "GmailPushMailbox" },
      { "name": "WHATSAPP_ACCOUNTS", "class_name": "WhatsAppAccount" },
      {
        "name": "USER_CREDENTIALS",
        "class_name": "UserCredentialBroker"
      },
      {
        "name": "AGENT_SUBJECTS",
        "class_name": "AgentSubjectDirectory"
      },
      {
        "name": "SPOTIFY_RATE_LIMITS",
        "class_name": "SpotifyRateLimit"
      },
      {
        "name": "USER_CONNECTORS",
        "class_name": "UserConnectorBroker"
      },
      {
        "name": "MCP_CONNECTIONS",
        "class_name": "McpConnectionDirectory"
      },
      {
        "name": "CHATGPT_EGRESS",
        "class_name": "ChatGptEgress",
        "script_name": "nanocodex"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CodexOAuthBroker"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["UserCredentialBroker", "AgentSubjectDirectory"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["CodexOAuthBroker"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["UserConnectorBroker"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["McpConnectionDirectory"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["SpotifyRateLimit"]
    },
    { "tag": "v7", "new_sqlite_classes": ["GmailPushMailbox"] },
    { "tag": "v8", "new_sqlite_classes": ["WhatsAppAccount"] },
    { "tag": "v9", "new_sqlite_classes": ["PhoneServiceAccount"] },
    { "tag": "v10", "new_sqlite_classes": ["UserCredentialSnapshot"] },
    { "tag": "v11", "deleted_classes": ["UserCredentialSnapshot"] }
  ],
  "env": {
    "development": {
      "name": "nanocodex-egress",
      "services": [
        { "binding": "TWILIO_PHONE_PROVIDER", "service": "nanocodex-durable-agent", "entrypoint": "PhoneProvider", "remote": false },
        {
          "binding": "MANAGED_AGENT_OWNERSHIP",
          "service": "nanocodex-durable-agent",
          "entrypoint": "ManagedAgentOwnership",
          "remote": false
        }
      ],
      "vars": {
        "ENVIRONMENT": "development",
        "ALLOW_LOCAL_CREDENTIAL_CLAIM": "true"
      },
      "durable_objects": {
        "bindings": [
          { "name": "PHONE_SERVICE_ACCOUNTS", "class_name": "PhoneServiceAccount" },
          { "name": "GMAIL_PUSH_MAILBOXES", "class_name": "GmailPushMailbox" },
          { "name": "WHATSAPP_ACCOUNTS", "class_name": "WhatsAppAccount" },
          { "name": "USER_CREDENTIALS", "class_name": "UserCredentialBroker" },
              { "name": "AGENT_SUBJECTS", "class_name": "AgentSubjectDirectory" },
          { "name": "SPOTIFY_RATE_LIMITS", "class_name": "SpotifyRateLimit" },
          { "name": "USER_CONNECTORS", "class_name": "UserConnectorBroker" },
          { "name": "MCP_CONNECTIONS", "class_name": "McpConnectionDirectory" },
          { "name": "CHATGPT_EGRESS", "class_name": "ChatGptEgress", "script_name": "nanocodex" }
        ]
      }
    }
  }
}
